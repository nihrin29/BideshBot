# Copy this file to ".env" and fill in your own values.
# The real .env file is never uploaded to GitHub.

# A long random text used by Flask to protect sessions and forms.
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database address.
# For local development a SQLite file is used.
# On the live website this will be the PostgreSQL address from Neon.
DATABASE_URL=sqlite:///bideshbot.db
